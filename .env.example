# Anthropic (used by the agent, not by sync)
ANTHROPIC_API_KEY=

# Postgres (docker-compose.yml default)
DATABASE_URL=postgresql://tri_analyze:tri_analyze@localhost:5435/tri_analyze
TEST_DATABASE_URL=postgresql://tri_analyze:tri_analyze@localhost:5435/tri_analyze_test

# Garmin: only needed to (re)authenticate; tokens live in ~/.garminconnect
GARMIN_EMAIL=
GARMIN_PASSWORD=

# TrainingPeaks: optional; leave blank if you ran `tp-mcp auth`
TP_AUTH_COOKIE=

# Pinned MCP server commits
GARMIN_MCP_REF=6c84f7ccf7ab496621357bb4e5e603ee4018fa13
TP_MCP_REF=a412a84eb4f9c8f03e108a1f27beb053d83a207d

# Defaults per role are DEFAULTS in tri_core/llm.py (analyst runs opus-5 / medium,
# nutrition_fuel runs claude-sonnet-5).
# One role: TRI_MODEL_<ROLE> and TRI_EFFORT_<ROLE> (low, medium, high, xhigh, max). Roles:
# COACH, ANALYST, WELLNESS_CHAT, PLANNING_AGENT, PLANNING_DESIGN, NUTRITION_AGENT, NUTRITION_FUEL,
# LAB_EXTRACT, LAB_REPORT, JUDGE. PLANNING_DESIGN, NUTRITION_FUEL, LAB_EXTRACT and JUDGE run
# structured output and take no effort.
# TRI_MODEL_ANALYST=claude-sonnet-5
# TRI_EFFORT_ANALYST=medium
# Models tried in order when the primary is overloaded or down; empty disables fallback.
# Default: the first two of claude-opus-5, claude-opus-4-8, claude-sonnet-5 that differ from it.
# TRI_MODEL_FALLBACKS=claude-opus-4-8,claude-sonnet-5

# LangSmith (optional, recommended while learning)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tri_analyze

# tri-analyze
TRI_ANALYZE_LANGSMITH_PROJECT=tri_analyze

# tri-planning
TRI_PLANNING_HORIZON_WEEKS=3
TRI_PLANNING_LANGSMITH_PROJECT=tri_planning

# tri-nutrition
TRI_NUTRITION_HORIZON_DAYS=14
TRI_NUTRITION_LANGSMITH_PROJECT=tri_nutrition

# tri-wellness
TRI_ATHLETE_SEX=male
TRI_WELLNESS_LANGSMITH_PROJECT=tri_wellness
TRI_WELLNESS_LIVE_PDF=
TRI_WELLNESS_LIVE_ROWS=
TRI_WELLNESS_LIVE_DRAWN_ON=

# tri-coach
TRI_COACH_LANGSMITH_PROJECT=tri_coach
TRI_COACH_MAX_CONSULTS_PER_DOMAIN=2
